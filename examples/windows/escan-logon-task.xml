<?xml version="1.0" encoding="UTF-8"?>
<!--
  Windows has no user-session service, so escan is run as a Scheduled Task that
  starts at logon and stays running. This is what `install.ps1 -Service`
  registers; import it by hand with:

    schtasks /Create /TN escan /XML examples\windows\escan-logon-task.xml

  Edit the Command and Arguments paths below to match your install first - the
  installer fills them in for you.
-->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Epson Stylus CX4300 scanner web UI</Description>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RestartOnFailure>
      <Interval>PT1M</Interval>
      <Count>3</Count>
    </RestartOnFailure>
    <!-- A 600 dpi full-bed scan takes minutes; never time the task out. -->
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Enabled>true</Enabled>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>%LOCALAPPDATA%\Programs\cx4300\escan.exe</Command>
      <Arguments>--addr 127.0.0.1:8080 --out %USERPROFILE%\scans</Arguments>
    </Exec>
  </Actions>
</Task>
